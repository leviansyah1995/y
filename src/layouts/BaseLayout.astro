---
/**
 * BaseLayout.astro — kerangka halaman sederhana (header + footer + slot)
 * Header/footer dari SiteHeader/SiteFooter (menu & sosial dari siteConfig.json).
 * Dipakai oleh: /blog/, /tentang/, /kontak/, /privasi/
 */
import siteConfig from '../data/siteConfig.json';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AnalyticsBeacons from '../components/AnalyticsBeacons.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = siteConfig.siteDescription } = Astro.props;

const siteBase = siteConfig.siteUrl.replace(/\/$/, '');
const origin = new URL(siteConfig.siteUrl).origin;
const pageTitle = `${title} — ${siteConfig.siteTitle}`;
const canonicalURL = new URL(Astro.url.pathname, origin).href;
const customMetaTags = (Array.isArray(siteConfig.customMetaTags) ? siteConfig.customMetaTags : [])
  .filter((t) => t && t.key && t.content);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.authorName} />
    <link rel="canonical" href={canonicalURL} />
    {customMetaTags.map((t) =>
      t.attribute === 'property'
        ? <meta property={t.key} content={t.content} />
        : <meta name={t.key} content={t.content} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.siteTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={`${siteBase}${siteConfig.defaultMetaImage}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />
    <AnalyticsBeacons />
    <link rel="icon" type="image/svg+xml" href={`${Astro.url.origin}${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
  </head>

  <body>
    <SiteHeader />

    <main class="container page">
      <slot />
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  :root {
    --ink: #0f172a;
    --muted: #475569;
    --accent: #4f46e5;
    --accent-soft: #eef2ff;
    --paper: #ffffff;
    --page: #f6f7fb;
    --line: #e2e8f0;
  }
  :global(*), :global(*::before), :global(*::after) { box-sizing: border-box; }
  html, body { overflow-x: clip; }
  img, svg, video { max-width: 100%; }
  body {
    margin: 0; background: var(--page); color: var(--ink);
    font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.7; -webkit-font-smoothing: antialiased;
  }
  .container { box-sizing: border-box; width: 100%; max-width: 1100px; margin-inline: auto; padding-inline: clamp(1rem, 4vw, 1.25rem); }
  .page { padding-block: 2.5rem 4rem; }

  .page :global(h1) { font-size: clamp(1.75rem, 4vw, 2.5rem); letter-spacing: -0.02em; line-height: 1.15; margin: 0 0 .5rem; }
  .page :global(h2) { font-size: 1.3rem; letter-spacing: -0.01em; margin: 2rem 0 .5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); }
  .page :global(a) { color: var(--accent); }
  .page :global(.lede) { color: var(--muted); font-size: 1.05rem; margin: 0 0 1.5rem; }
</style>

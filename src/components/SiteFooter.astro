---
/**
 * SiteFooter.astro — Footer publik: sosial + menu (dari siteConfig.json) + tagline.
 * Sosial & tagline bisa diedit dari /admin → ⚙️ Pengaturan Situs → [SOSIAL] / [TEKS].
 */
import siteConfig from '../data/siteConfig.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (p?: string) => {
  if (!p) return '#';
  if (/^(https?:)?\/\//.test(p) || p.startsWith('#') || p.startsWith('mailto:')) return p;
  return `${base}${p.startsWith('/') ? p : `/${p}`}`;
};

const socials = (Array.isArray(siteConfig.socials) ? siteConfig.socials : [])
  .filter((s) => s && s.url && s.platform)
  .slice(0, 6);

const nav = (Array.isArray(siteConfig.nav) ? siteConfig.nav : [])
  .filter((item) => item && item.label && item.href)
  .slice(0, 6);

// Ikon stroke (feather-style) per platform — fallback: ikon link
const icons: Record<string, string> = {
  github: '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.9a3.4 3.4 0 0 0-1-2.6c3-.3 6-1.5 6-6.8A5.3 5.3 0 0 0 20.6 4.5 5 5 0 0 0 20.5.4S19.4.1 16.9 2a13.4 13.4 0 0 0-7 0C6.6.1 4.6.4 4.6.4A5 5 0 0 0 4.5 4.5 5.3 5.3 0 0 0 3.5 8.2c0 5.3 3 6.5 6 6.8a3.4 3.4 0 0 0-1 2.6V22"/>',
  youtube: '<rect x="2" y="6" width="20" height="12" rx="4"/><path d="M10.5 9.5l5 2.5-5 2.5z" fill="currentColor" stroke="none"/>',
  telegram: '<path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4z"/>',
  twitter: '<path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/>',
  x: '<path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/>',
  instagram: '<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>',
  linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V8h4"/><rect x="2" y="9" width="4" height="12"/>',
  email: '<path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><path d="m22 6-10 7L2 6"/>',
};
const fallbackIcon = '<path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/>';
const iconFor = (platform: string) => icons[platform.trim().toLowerCase()] ?? fallbackIcon;

const footerTagline = (siteConfig.footerTagline ?? '').trim()
  || 'Dibangun dengan Astro · Konten dikelola via Sveltia CMS · Deploy via Cloudflare Pages';
---

<footer class="site-footer">
  <div class="container footer-inner">
    {socials.length > 0 && (
      <div class="social-row" aria-label="Media sosial">
        {socials.map((s) => (
          <a class="social-btn" href={s.url} target="_blank" rel="noopener noreferrer me" aria-label={s.platform} title={s.platform}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconFor(s.platform)} />
          </a>
        ))}
      </div>
    )}

    <nav class="footer-nav" aria-label="Navigasi footer">
      {nav.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
      <a href={withBase('/privasi/')}>Privasi</a>
    </nav>

    <p>© {new Date().getFullYear()} {siteConfig.authorName} · {siteConfig.siteTitle}</p>
    <p class="footer-note">{footerTagline}</p>
  </div>
</footer>

<style>
  .container { width: 100%; max-width: 1100px; margin-inline: auto; padding-inline: 1.25rem; }
  .site-footer { border-top: 1px solid #e2e8f0; background: #fff; }
  .footer-inner { padding-block: 1.6rem 1.4rem; text-align: center; font-size: .85rem; color: #475569; }

  .social-row { display: flex; justify-content: center; gap: .55rem; margin-bottom: .75rem; }
  .social-btn { display: grid; place-items: center; width: 38px; height: 38px; border-radius: .7rem; border: 1px solid #e2e8f0; color: #475569; transition: all .18s ease; }
  .social-btn:hover { color: #4f46e5; border-color: #c7d2fe; background: #eef2ff; transform: translateY(-2px); }
  .social-btn svg { width: 18px; height: 18px; }

  .footer-nav { display: flex; gap: 1.1rem; justify-content: center; margin-bottom: .6rem; flex-wrap: wrap; }
  .footer-nav a { color: #475569; text-decoration: none; font-weight: 600; font-size: .85rem; }
  .footer-nav a:hover { color: #4f46e5; }

  .footer-inner p { margin: .15rem 0; }
  .footer-note { font-size: .78rem; opacity: .85; margin-top: .35rem !important; }
</style>

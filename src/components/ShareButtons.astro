---
/**
 * ShareButtons.astro — Tombol bagikan artikel (X, Facebook, LinkedIn, WhatsApp, Telegram, Salin link)
 * URL & judul di-encode saat build — tidak butuh dependensi eksternal.
 */
interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);

const links = [
  {
    label: 'X',
    href: `https://twitter.com/intent/tweet?text=${t}&url=${u}`,
    icon: '<path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/>',
  },
  {
    label: 'Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
    icon: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
  },
  {
    label: 'LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
    icon: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V8h4"/><rect x="2" y="9" width="4" height="12"/>',
  },
  {
    label: 'WhatsApp',
    href: `https://wa.me/?text=${t}%20${u}`,
    icon: '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 6 8.38 8.38 0 0 1-3.8-.9L3 21l1.6-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 6-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>',
  },
  {
    label: 'Telegram',
    href: `https://t.me/share/url?url=${u}&text=${t}`,
    icon: '<path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4z"/>',
  },
];

const copyIcon = '<path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/>';
const checkIcon = '<path d="M20 6 9 17l-5-5"/>';
---

<div class="share" role="group" aria-label="Bagikan artikel ini">
  <span class="share-label">Bagikan:</span>
  {links.map((l) => (
    <a class="share-btn" href={l.href} target="_blank" rel="noopener noreferrer" aria-label={`Bagikan ke ${l.label}`} title={l.label}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={l.icon} />
      <span class="share-text">{l.label}</span>
    </a>
  ))}
  <button type="button" class="share-btn copy-btn" data-url={url} aria-label="Salin tautan artikel" title="Salin tautan">
    <svg class="ic-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={copyIcon} />
    <svg class="ic-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={checkIcon} style="display:none" />
    <span class="share-text copy-label">Salin link</span>
  </button>
</div>

<script is:inline>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.getAttribute('data-url') || window.location.href;
      const label = btn.querySelector('.copy-label');
      const icCopy = btn.querySelector('.ic-copy');
      const icCheck = btn.querySelector('.ic-check');
      const done = () => {
        btn.classList.add('copied');
        if (label) label.textContent = 'Tersalin!';
        if (icCopy) icCopy.style.display = 'none';
        if (icCheck) icCheck.style.display = 'inline';
        setTimeout(() => {
          btn.classList.remove('copied');
          if (label) label.textContent = 'Salin link';
          if (icCopy) icCopy.style.display = 'inline';
          if (icCheck) icCheck.style.display = 'none';
        }, 2200);
      };
      try {
        await navigator.clipboard.writeText(url);
        done();
      } catch {
        const ta = document.createElement('textarea');
        ta.value = url;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); done(); } catch (_) { /* biarkan */ }
        ta.remove();
      }
    });
  });
</script>

<style>
  .share {
    display: flex; align-items: center; gap: .5rem; flex-wrap: wrap;
    margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid #e2e8f0;
  }
  .share-label { font-size: .78rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: #475569; margin-right: .25rem; }
  .share-btn {
    display: inline-flex; align-items: center; gap: .4rem;
    padding: .42rem .7rem; border-radius: .6rem; border: 1px solid #e2e8f0;
    background: #fff; color: #334155; font-size: .8rem; font-weight: 600;
    text-decoration: none; cursor: pointer; transition: all .18s ease;
    font-family: inherit;
  }
  .share-btn svg { width: 16px; height: 16px; }
  .share-btn:hover { border-color: #c7d2fe; color: #4f46e5; background: #eef2ff; transform: translateY(-1px); }
  .copy-btn.copied { border-color: #86efac; color: #15803d; background: #f0fdf4; }

  @media (max-width: 640px) {
    .share-text { display: none; }
    .share-btn { padding: .45rem .55rem; }
  }
</style>
